rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['role', 'admin'])
        && request.resource.data.keys().hasOnly([
          'displayName', 'photoUrl', 'createdAt', 'lastActiveAt'
        ]);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'admin']);
      allow delete: if false;
    }

    match /hazardReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /hazards/{hazardId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;

      match /reports/{reportId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      match /confirmations/{confirmationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /sensorEvents/{eventId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    match /roadSegments/{segmentId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }

    match /routeAssessments/{assessmentId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /guardianPulseEvents/{pulseId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
